+
+class CategoryEntityAdapter extends TypeAdapter<CategoryEntity> {
+  @override
+  final int typeId = 3;
+
+  @override
+  CategoryEntity read(BinaryReader reader) {
+    return CategoryEntity(
+      name: reader.readString(),
+    );
+  }
+
